  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 50, "left": 200, "attrs": { "color": "green" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 150, "left": 200, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "led1", "top": 120, "left": 300, "attrs": { "color": "red" } }
